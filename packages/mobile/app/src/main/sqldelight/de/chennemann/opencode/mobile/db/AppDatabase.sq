CREATE TABLE meta (
  id INTEGER NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE settings (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE app_log (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  created_at INTEGER NOT NULL,
  level TEXT NOT NULL,
  logical_unit TEXT NOT NULL,
  tag TEXT NOT NULL,
  event TEXT NOT NULL,
  project_id TEXT,
  project_name TEXT,
  session_id TEXT,
  session_title TEXT,
  message TEXT NOT NULL,
  context_json TEXT NOT NULL,
  throwable TEXT,
  redacted INTEGER NOT NULL
);

CREATE INDEX app_log_created_at_idx ON app_log(created_at DESC, id DESC);
CREATE INDEX app_log_logical_unit_idx ON app_log(logical_unit, created_at DESC, id DESC);
CREATE INDEX app_log_level_idx ON app_log(level, created_at DESC, id DESC);
CREATE INDEX app_log_event_idx ON app_log(event, created_at DESC, id DESC);
CREATE INDEX app_log_project_idx ON app_log(project_id, created_at DESC, id DESC);
CREATE INDEX app_log_session_idx ON app_log(session_id, created_at DESC, id DESC);

CREATE TABLE project (
  id TEXT NOT NULL PRIMARY KEY,
  worktree TEXT NOT NULL,
  name TEXT NOT NULL,
  sandboxes_json TEXT NOT NULL,
  favorite INTEGER NOT NULL DEFAULT 0,
  hidden INTEGER NOT NULL DEFAULT 0,
  selected INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL
);

CREATE TABLE session (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  title TEXT NOT NULL,
  version TEXT NOT NULL,
  directory TEXT NOT NULL,
  parent_id TEXT,
  updated_at INTEGER,
  archived_at INTEGER,
  focused INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE message (
  id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL,
  role TEXT NOT NULL,
  text TEXT NOT NULL,
  sort_key TEXT NOT NULL,
  created_at INTEGER,
  completed_at INTEGER,
  local_message_id TEXT,
  pending INTEGER NOT NULL DEFAULT 0,
  send_state TEXT NOT NULL DEFAULT 'none',
  updated_at INTEGER NOT NULL
);

CREATE TABLE outbox (
  outbox_id TEXT NOT NULL PRIMARY KEY,
  type TEXT NOT NULL,
  status TEXT NOT NULL,
  session_id TEXT NOT NULL,
  directory TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  local_message_id TEXT,
  server_message_id TEXT,
  attempt_count INTEGER NOT NULL DEFAULT 0,
  available_at INTEGER NOT NULL,
  last_error TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE command (
  project_id TEXT NOT NULL,
  name TEXT NOT NULL,
  description TEXT,
  source TEXT,
  PRIMARY KEY (project_id, name)
);

CREATE TABLE connection (
  id INTEGER NOT NULL PRIMARY KEY,
  endpoint TEXT NOT NULL,
  discovered TEXT,
  status TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE sync_state (
  session_id TEXT NOT NULL PRIMARY KEY,
  status TEXT NOT NULL,
  last_snapshot_at INTEGER,
  last_stream_seen_at INTEGER,
  last_error_at INTEGER,
  next_sync_at INTEGER NOT NULL DEFAULT 0,
  retry_count INTEGER NOT NULL DEFAULT 0,
  expects_remote_updates INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL
);

CREATE TABLE stream_policy (
  id INTEGER NOT NULL PRIMARY KEY,
  stream_connected INTEGER NOT NULL DEFAULT 0,
  disconnect_deadline_at INTEGER,
  focused_session_id TEXT,
  updated_at INTEGER NOT NULL
);

CREATE TABLE preference (
  id INTEGER NOT NULL PRIMARY KEY,
  quick_switch_scope TEXT NOT NULL,
  sort_mode TEXT NOT NULL,
  logs_filter_json TEXT NOT NULL,
  logs_retention_policy TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE INDEX project_worktree_idx ON project(worktree);
CREATE INDEX project_selected_idx ON project(selected, updated_at DESC, id DESC);
CREATE INDEX session_project_idx ON session(project_id, archived_at, updated_at DESC, id DESC);
CREATE INDEX session_focused_idx ON session(focused, updated_at DESC, id DESC);
CREATE INDEX message_session_sort_idx ON message(session_id, sort_key DESC, id DESC);
CREATE INDEX message_local_idx ON message(local_message_id);
CREATE INDEX outbox_status_available_idx ON outbox(status, available_at ASC, created_at ASC, outbox_id ASC);
CREATE INDEX outbox_session_created_idx ON outbox(session_id, created_at DESC, outbox_id DESC);
CREATE INDEX outbox_local_message_idx ON outbox(local_message_id);
CREATE INDEX command_project_idx ON command(project_id, name);
CREATE INDEX sync_state_status_idx ON sync_state(status, updated_at DESC, session_id DESC);
CREATE INDEX sync_state_due_idx ON sync_state(next_sync_at ASC, status, updated_at ASC, session_id ASC);

selectSetting:
SELECT value FROM settings WHERE key = ?;

upsertSetting:
INSERT INTO settings(key, value)
VALUES (?, ?)
ON CONFLICT(key) DO UPDATE SET value = excluded.value;

deleteSetting:
DELETE FROM settings WHERE key = ?;

insertAppLog:
INSERT INTO app_log(
  created_at,
  level,
  logical_unit,
  tag,
  event,
  project_id,
  project_name,
  session_id,
  session_title,
  message,
  context_json,
  throwable,
  redacted
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

listAppLog:
SELECT id, created_at, level, logical_unit, tag, event, project_id, project_name, session_id, session_title, message, context_json, throwable, redacted
FROM app_log
WHERE (:logical_unit IS NULL OR logical_unit = :logical_unit)
  AND (:level IS NULL OR level = :level)
  AND (:event IS NULL OR event = :event)
  AND (:project_id IS NULL OR project_id = :project_id)
  AND (:session_id IS NULL OR session_id = :session_id)
  AND (:from_at IS NULL OR created_at >= :from_at)
  AND (:until_at IS NULL OR created_at <= :until_at)
  AND (
    :search IS NULL
    OR message LIKE '%' || :search || '%'
    OR event LIKE '%' || :search || '%'
    OR tag LIKE '%' || :search || '%'
    OR project_name LIKE '%' || :search || '%'
    OR session_title LIKE '%' || :search || '%'
  )
ORDER BY created_at DESC, id DESC
LIMIT :limit;

listAppLogProjectFacet:
SELECT project_id, max(project_name) AS project_name
FROM app_log
WHERE project_id IS NOT NULL
GROUP BY project_id
ORDER BY max(project_name) COLLATE NOCASE ASC, project_id ASC;

listAppLogSessionFacet:
SELECT session_id, max(session_title) AS session_title
FROM app_log
WHERE session_id IS NOT NULL
GROUP BY session_id
ORDER BY max(session_title) COLLATE NOCASE ASC, session_id ASC;

listAppLogEventFacet:
SELECT event
FROM app_log
GROUP BY event
ORDER BY event COLLATE NOCASE ASC;

countAppLog:
SELECT count(*)
FROM app_log;

deleteAppLogBefore:
DELETE FROM app_log
WHERE created_at < ?;

deleteAppLogOverflow:
DELETE FROM app_log
WHERE id IN (
  SELECT id
  FROM app_log
  ORDER BY created_at DESC, id DESC
  LIMIT -1 OFFSET ?
);

deleteAppLogAll:
DELETE FROM app_log;

observeSessionList:
SELECT id, title, version, directory, parent_id, updated_at, archived_at
FROM session
WHERE project_id = :project_id
  AND (:include_archived = 1 OR archived_at IS NULL)
  AND (
    :query = ''
    OR title LIKE '%' || :query || '%'
    OR directory LIKE '%' || :query || '%'
  )
ORDER BY COALESCE(updated_at, 0) DESC, id DESC
LIMIT :limit;

observeFocusedSession:
SELECT id, title, version, directory, parent_id, updated_at, archived_at
FROM session
WHERE focused = 1
ORDER BY COALESCE(updated_at, 0) DESC, id DESC
LIMIT 1;

observeMessagePage:
SELECT id, role, text, sort_key, created_at, completed_at
FROM message
WHERE session_id = :session_id
  AND (
    :before_message_id IS NULL
    OR sort_key < COALESCE(
      (
        SELECT sort_key
        FROM message
        WHERE session_id = :session_id
          AND id = :before_message_id
      ),
      '~~~~~~~~'
    )
  )
ORDER BY sort_key DESC, id DESC
LIMIT :limit;

observeProjects:
SELECT id, worktree, name, sandboxes_json, favorite
FROM project
WHERE hidden = 0
ORDER BY favorite DESC, name COLLATE NOCASE ASC, worktree ASC;

observeSelectedProject:
SELECT id, worktree, name, sandboxes_json, favorite
FROM project
WHERE selected = 1
ORDER BY updated_at DESC, id DESC
LIMIT 1;

observeCommands:
SELECT project_id, name, description, source
FROM command
WHERE project_id = ?
ORDER BY name COLLATE NOCASE ASC, name ASC;

observeConnection:
SELECT endpoint, discovered, status
FROM connection
WHERE id = 1;

observeSyncState:
SELECT session_id, status, last_snapshot_at, last_stream_seen_at, last_error_at
FROM sync_state
WHERE session_id = ?;

observePrefs:
SELECT quick_switch_scope, sort_mode, logs_filter_json, logs_retention_policy
FROM preference
WHERE id = 1;

upsertProject:
INSERT INTO project(id, worktree, name, sandboxes_json, favorite, updated_at)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  worktree = excluded.worktree,
  name = excluded.name,
  sandboxes_json = excluded.sandboxes_json,
  favorite = excluded.favorite,
  updated_at = excluded.updated_at;

selectProjectById:
SELECT id, worktree, name, sandboxes_json, favorite, hidden, selected
FROM project
WHERE id = ?;

clearProjectSelection:
UPDATE project
SET selected = 0;

selectProjectByWorktree:
SELECT id, worktree, name, sandboxes_json, favorite, hidden, selected
FROM project
WHERE worktree = ?
LIMIT 1;

setProjectSelected:
UPDATE project
SET selected = 1,
    updated_at = ?
WHERE id = ?;

setProjectFavorite:
UPDATE project
SET favorite = ?,
    updated_at = ?
WHERE id = ?;

setProjectHidden:
UPDATE project
SET hidden = ?,
    updated_at = ?
WHERE id = ?;

upsertSession:
INSERT INTO session(id, project_id, title, version, directory, parent_id, updated_at, archived_at, focused)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  project_id = excluded.project_id,
  title = excluded.title,
  version = excluded.version,
  directory = excluded.directory,
  parent_id = excluded.parent_id,
  updated_at = excluded.updated_at,
  archived_at = excluded.archived_at,
  focused = excluded.focused;

clearFocusedSession:
UPDATE session
SET focused = 0
WHERE focused = 1;

setFocusedSession:
UPDATE session
SET focused = 1
WHERE id = ?;

insertMessage:
INSERT INTO message(id, session_id, role, text, sort_key, created_at, completed_at, local_message_id, pending, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  session_id = excluded.session_id,
  role = excluded.role,
  text = excluded.text,
  sort_key = excluded.sort_key,
  created_at = excluded.created_at,
  completed_at = excluded.completed_at,
  local_message_id = excluded.local_message_id,
  pending = excluded.pending,
  updated_at = excluded.updated_at;

selectMessageById:
SELECT id, session_id, role, text, sort_key, created_at, completed_at, local_message_id, pending, send_state, updated_at
FROM message
WHERE id = ?
LIMIT 1;

selectMessageByLocalId:
SELECT id, session_id, role, text, sort_key, created_at, completed_at, local_message_id, pending, send_state, updated_at
FROM message
WHERE local_message_id = ?
LIMIT 1;

selectMessagePatchMetaByLocalId:
SELECT id, session_id, sort_key, pending, send_state, updated_at
FROM message
WHERE local_message_id = :local_message_id
   OR id = :id_
LIMIT 1;

markMessageSendUnknown:
UPDATE message
SET pending = 0,
    send_state = 'send_unknown',
    updated_at = :updated_at
WHERE session_id = :session_id
  AND (
    local_message_id = :local_message_id
    OR id = :local_message_id
  );

setMessageSendState:
UPDATE message
SET send_state = :send_state,
    updated_at = :updated_at
WHERE session_id = :session_id
  AND (
    local_message_id = :local_message_id
    OR id = :local_message_id
  );

confirmLocalMessage:
UPDATE message
SET id = ?,
    local_message_id = NULL,
    pending = 0,
    send_state = 'sent',
    updated_at = ?
WHERE id = ?
  AND session_id = ?;

enqueueOutbox:
INSERT INTO outbox(
  outbox_id,
  type,
  status,
  session_id,
  directory,
  payload_json,
  local_message_id,
  server_message_id,
  attempt_count,
  available_at,
  last_error,
  created_at,
  updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, ?, NULL, ?, ?);

listDueOutbox:
SELECT outbox_id, type, status, session_id, directory, payload_json, local_message_id, server_message_id, attempt_count, available_at, last_error, created_at, updated_at
FROM outbox
WHERE status IN ('PENDING', 'FAILED')
  AND available_at <= :available_at
ORDER BY available_at ASC, created_at ASC, outbox_id ASC
LIMIT :limit;

markOutboxSending:
UPDATE outbox
SET status = 'SENDING',
    attempt_count = attempt_count + 1,
    last_error = NULL,
    updated_at = :updated_at
WHERE outbox_id = :outbox_id;

markOutboxDone:
UPDATE outbox
SET status = 'DONE',
    server_message_id = COALESCE(:server_message_id, server_message_id),
    last_error = NULL,
    updated_at = :updated_at
WHERE outbox_id = :outbox_id;

markOutboxFailed:
UPDATE outbox
SET status = 'FAILED',
    available_at = :available_at,
    last_error = :last_error,
    updated_at = :updated_at
WHERE outbox_id = :outbox_id;

selectOutboxById:
SELECT outbox_id, type, status, session_id, directory, payload_json, local_message_id, server_message_id, attempt_count, available_at, last_error, created_at, updated_at
FROM outbox
WHERE outbox_id = ?
LIMIT 1;

archiveSession:
UPDATE session
SET archived_at = ?
WHERE id = ?;

renameSession:
UPDATE session
SET title = ?
WHERE id = ?;

upsertSyncState:
INSERT INTO sync_state(session_id, status, last_snapshot_at, last_stream_seen_at, last_error_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(session_id) DO UPDATE SET
  status = excluded.status,
  last_snapshot_at = excluded.last_snapshot_at,
  last_stream_seen_at = excluded.last_stream_seen_at,
  last_error_at = excluded.last_error_at,
  updated_at = excluded.updated_at;

setSyncQueued:
INSERT INTO sync_state(session_id, status, next_sync_at, updated_at)
VALUES (:session_id, 'QUEUED', :updated_at, :updated_at)
ON CONFLICT(session_id) DO UPDATE SET
  status = excluded.status,
  next_sync_at = excluded.next_sync_at,
  updated_at = excluded.updated_at;

listDueSyncState:
SELECT session_id, status, last_snapshot_at, last_stream_seen_at, last_error_at, next_sync_at, retry_count, expects_remote_updates, updated_at
FROM sync_state
WHERE next_sync_at <= :now
  AND status IN ('QUEUED', 'BACKOFF')
ORDER BY next_sync_at ASC, updated_at ASC, session_id ASC
LIMIT :limit;

markSyncRunning:
UPDATE sync_state
SET status = 'RUNNING',
    updated_at = :updated_at
WHERE session_id = :session_id;

markSyncIdle:
UPDATE sync_state
SET status = 'IDLE',
    last_snapshot_at = :last_snapshot_at,
    last_error_at = NULL,
    retry_count = 0,
    next_sync_at = :next_sync_at,
    updated_at = :updated_at
WHERE session_id = :session_id;

markSyncBackoff:
UPDATE sync_state
SET status = 'BACKOFF',
    last_error_at = :last_error_at,
    retry_count = retry_count + 1,
    next_sync_at = :next_sync_at,
    updated_at = :updated_at
WHERE session_id = :session_id;

markSyncFailed:
UPDATE sync_state
SET status = 'FAILED',
    last_error_at = :last_error_at,
    next_sync_at = :next_sync_at,
    updated_at = :updated_at
WHERE session_id = :session_id;

markSyncStreamSeen:
INSERT INTO sync_state(session_id, status, last_stream_seen_at, next_sync_at, updated_at)
VALUES (:session_id, 'QUEUED', :seen_at, :seen_at, :updated_at)
ON CONFLICT(session_id) DO UPDATE SET
  last_stream_seen_at = :seen_at,
  updated_at = :updated_at;

setSyncExpectation:
INSERT INTO sync_state(session_id, status, expects_remote_updates, next_sync_at, updated_at)
VALUES (:session_id, 'IDLE', :expects_remote_updates, 0, :updated_at)
ON CONFLICT(session_id) DO UPDATE SET
  expects_remote_updates = :expects_remote_updates,
  updated_at = :updated_at;

selectSyncExpectation:
SELECT expects_remote_updates
FROM sync_state
WHERE session_id = :session_id
LIMIT 1;

selectStreamPolicy:
SELECT stream_connected, disconnect_deadline_at, focused_session_id, updated_at
FROM stream_policy
WHERE id = 1
LIMIT 1;

upsertStreamPolicy:
INSERT INTO stream_policy(id, stream_connected, disconnect_deadline_at, focused_session_id, updated_at)
VALUES (1, :stream_connected, :disconnect_deadline_at, :focused_session_id, :updated_at)
ON CONFLICT(id) DO UPDATE SET
  stream_connected = excluded.stream_connected,
  disconnect_deadline_at = excluded.disconnect_deadline_at,
  focused_session_id = excluded.focused_session_id,
  updated_at = excluded.updated_at;

deleteCommandsByProject:
DELETE FROM command
WHERE project_id = ?;

upsertCommand:
INSERT INTO command(project_id, name, description, source)
VALUES (?, ?, ?, ?)
ON CONFLICT(project_id, name) DO UPDATE SET
  description = excluded.description,
  source = excluded.source;

findCommand:
SELECT project_id, name, description, source
FROM command
WHERE project_id = ?
  AND name = ?
LIMIT 1;

upsertConnection:
INSERT INTO connection(id, endpoint, discovered, status, updated_at)
VALUES (1, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  endpoint = excluded.endpoint,
  discovered = excluded.discovered,
  status = excluded.status,
  updated_at = excluded.updated_at;

setConnectionEndpoint:
INSERT INTO connection(id, endpoint, discovered, status, updated_at)
VALUES (1, ?, NULL, 'IDLE', ?)
ON CONFLICT(id) DO UPDATE SET
  endpoint = excluded.endpoint,
  updated_at = excluded.updated_at;

setConnectionStatus:
INSERT INTO connection(id, endpoint, discovered, status, updated_at)
VALUES (1, '', NULL, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  status = excluded.status,
  updated_at = excluded.updated_at;

setConnectionDiscovery:
INSERT INTO connection(id, endpoint, discovered, status, updated_at)
VALUES (1, '', ?, 'IDLE', ?)
ON CONFLICT(id) DO UPDATE SET
  discovered = excluded.discovered,
  updated_at = excluded.updated_at;

upsertPreference:
INSERT INTO preference(id, quick_switch_scope, sort_mode, logs_filter_json, logs_retention_policy, updated_at)
VALUES (1, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  quick_switch_scope = excluded.quick_switch_scope,
  sort_mode = excluded.sort_mode,
  logs_filter_json = excluded.logs_filter_json,
  logs_retention_policy = excluded.logs_retention_policy,
  updated_at = excluded.updated_at;
