CREATE TABLE meta (
  id INTEGER NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE settings (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE session_cache (
  server_url TEXT NOT NULL,
  session_id TEXT NOT NULL,
  project_id TEXT,
  directory TEXT NOT NULL,
  title TEXT NOT NULL,
  version TEXT NOT NULL,
  last_opened_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  PRIMARY KEY (server_url, session_id)
);

CREATE TABLE message_cache (
  server_url TEXT NOT NULL,
  session_id TEXT NOT NULL,
  message_id TEXT NOT NULL,
  role TEXT NOT NULL,
  text TEXT NOT NULL,
  sort_key TEXT NOT NULL,
  created_at INTEGER,
  completed_at INTEGER,
  updated_at INTEGER NOT NULL,
  PRIMARY KEY (server_url, session_id, message_id)
);

CREATE TABLE app_log (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  created_at INTEGER NOT NULL,
  level TEXT NOT NULL,
  logical_unit TEXT NOT NULL,
  tag TEXT NOT NULL,
  event TEXT NOT NULL,
  project_id TEXT,
  project_name TEXT,
  session_id TEXT,
  session_title TEXT,
  message TEXT NOT NULL,
  context_json TEXT NOT NULL,
  throwable TEXT,
  redacted INTEGER NOT NULL
);

CREATE INDEX app_log_created_at_idx ON app_log(created_at DESC, id DESC);
CREATE INDEX app_log_logical_unit_idx ON app_log(logical_unit, created_at DESC, id DESC);
CREATE INDEX app_log_level_idx ON app_log(level, created_at DESC, id DESC);
CREATE INDEX app_log_event_idx ON app_log(event, created_at DESC, id DESC);
CREATE INDEX app_log_project_idx ON app_log(project_id, created_at DESC, id DESC);
CREATE INDEX app_log_session_idx ON app_log(session_id, created_at DESC, id DESC);

selectSetting:
SELECT value FROM settings WHERE key = ?;

upsertSetting:
INSERT INTO settings(key, value)
VALUES (?, ?)
ON CONFLICT(key) DO UPDATE SET value = excluded.value;

deleteSetting:
DELETE FROM settings WHERE key = ?;

upsertSessionCache:
INSERT INTO session_cache(
  server_url,
  session_id,
  project_id,
  directory,
  title,
  version,
  last_opened_at,
  updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(server_url, session_id) DO UPDATE SET
  project_id = excluded.project_id,
  directory = excluded.directory,
  title = excluded.title,
  version = excluded.version,
  last_opened_at = excluded.last_opened_at,
  updated_at = excluded.updated_at;

upsertSessionCacheSnapshot:
INSERT INTO session_cache(
  server_url,
  session_id,
  project_id,
  directory,
  title,
  version,
  last_opened_at,
  updated_at
)
VALUES (?, ?, ?, ?, ?, ?, 0, ?)
ON CONFLICT(server_url, session_id) DO UPDATE SET
  project_id = excluded.project_id,
  directory = excluded.directory,
  title = excluded.title,
  version = excluded.version,
  updated_at = excluded.updated_at;

selectRecentSessionCache:
SELECT server_url, session_id, project_id, directory, title, version, last_opened_at, updated_at
FROM session_cache
ORDER BY last_opened_at DESC
LIMIT 1;

selectSessionCache:
SELECT server_url, session_id, project_id, directory, title, version, last_opened_at, updated_at
FROM session_cache
WHERE server_url = ? AND session_id = ?;

listProjectSessionCache:
SELECT server_url, session_id, project_id, directory, title, version, last_opened_at, updated_at
FROM session_cache
WHERE server_url = ? AND project_id = ?
ORDER BY updated_at DESC, session_id DESC;

listProjectSessionCacheLimited:
SELECT server_url, session_id, project_id, directory, title, version, last_opened_at, updated_at
FROM session_cache
WHERE server_url = ? AND project_id = ?
ORDER BY updated_at DESC, session_id DESC
LIMIT ?;

deleteSessionCache:
DELETE FROM session_cache
WHERE server_url = ? AND session_id = ?;

listMessageCache:
SELECT server_url, session_id, message_id, role, text, sort_key, created_at, completed_at, updated_at
FROM message_cache
WHERE server_url = ? AND session_id = ?
ORDER BY sort_key ASC;

upsertMessageCache:
INSERT INTO message_cache(
  server_url,
  session_id,
  message_id,
  role,
  text,
  sort_key,
  created_at,
  completed_at,
  updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(server_url, session_id, message_id) DO UPDATE SET
  role = excluded.role,
  text = excluded.text,
  sort_key = excluded.sort_key,
  created_at = excluded.created_at,
  completed_at = excluded.completed_at,
  updated_at = excluded.updated_at;

deleteMessageCache:
DELETE FROM message_cache
WHERE server_url = ? AND session_id = ? AND message_id = ?;

deleteMessageCacheSession:
DELETE FROM message_cache
WHERE server_url = ? AND session_id = ?;

insertAppLog:
INSERT INTO app_log(
  created_at,
  level,
  logical_unit,
  tag,
  event,
  project_id,
  project_name,
  session_id,
  session_title,
  message,
  context_json,
  throwable,
  redacted
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

listAppLog:
SELECT id, created_at, level, logical_unit, tag, event, project_id, project_name, session_id, session_title, message, context_json, throwable, redacted
FROM app_log
WHERE (:logical_unit IS NULL OR logical_unit = :logical_unit)
  AND (:level IS NULL OR level = :level)
  AND (:event IS NULL OR event = :event)
  AND (:project_id IS NULL OR project_id = :project_id)
  AND (:session_id IS NULL OR session_id = :session_id)
  AND (:from_at IS NULL OR created_at >= :from_at)
  AND (:until_at IS NULL OR created_at <= :until_at)
  AND (
    :search IS NULL
    OR message LIKE '%' || :search || '%'
    OR event LIKE '%' || :search || '%'
    OR tag LIKE '%' || :search || '%'
    OR project_name LIKE '%' || :search || '%'
    OR session_title LIKE '%' || :search || '%'
  )
ORDER BY created_at DESC, id DESC
LIMIT :limit;

listAppLogProjectFacet:
SELECT project_id, max(project_name) AS project_name
FROM app_log
WHERE project_id IS NOT NULL
GROUP BY project_id
ORDER BY max(project_name) COLLATE NOCASE ASC, project_id ASC;

listAppLogSessionFacet:
SELECT session_id, max(session_title) AS session_title
FROM app_log
WHERE session_id IS NOT NULL
GROUP BY session_id
ORDER BY max(session_title) COLLATE NOCASE ASC, session_id ASC;

listAppLogEventFacet:
SELECT event
FROM app_log
GROUP BY event
ORDER BY event COLLATE NOCASE ASC;

countAppLog:
SELECT count(*)
FROM app_log;

deleteAppLogBefore:
DELETE FROM app_log
WHERE created_at < ?;

deleteAppLogOverflow:
DELETE FROM app_log
WHERE id IN (
  SELECT id
  FROM app_log
  ORDER BY created_at DESC, id DESC
  LIMIT -1 OFFSET ?
);

deleteAppLogAll:
DELETE FROM app_log;
